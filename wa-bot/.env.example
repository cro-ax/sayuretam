# ====== WAJIB ======
GEMINI_API_KEY=isi_api_key_gemini_kamu

# Nomor/LID admin (pisahkan dengan koma). Admin selalu dibalas & bisa pakai semua command.
# Angka panjang tanpa @lid otomatis dicek sebagai nomor HP DAN LID.
OWNER_IDS=6281234567890

# admin = hanya KAMU yang mendaftarkan orang (default). Caranya: buka chat orang itu di HP,
#         ketik !add  -> dia langsung bisa tanya ke bot. Orang lain ketik !add tidak ada efek.
# self  = orang bisa daftar sendiri dengan mengetik !add
REGISTER_MODE=admin
# Kirim pesan sambutan ke orang yang baru kamu !add (true/false)
ADD_SEND_WELCOME=true
# Hapus pesan "!add" yang kamu ketik di chat orang itu supaya tidak terlihat (true/false)
DELETE_COMMAND_MSG=true

# ====== MODEL AI ======
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Kalau model utama lebih lama dari ini (ms), pindah ke fallback
AI_TIMEOUT_MS=12000
# Batas waktu untuk model fallback (ms)
AI_FALLBACK_TIMEOUT_MS=25000
# Kreativitas jawaban (0 = kaku/konsisten, 1 = bebas)
AI_TEMPERATURE=0.4
# Batas panjang jawaban (token). Token "berpikir" ikut dihitung, jadi jangan kecil.
AI_MAX_TOKENS=8192
# Kosong = bawaan model. Isi angka (mis. 1024) untuk membatasi "berpikir" supaya lebih cepat.
AI_THINKING_BUDGET=

# ====== PERILAKU BOT ======
# Jumlah giliran percakapan yang diingat per orang (1 giliran = tanya + jawab)
HISTORY_TURNS=6
# Ingatan percakapan hilang kalau orangnya diam selama (menit)
HISTORY_TTL_MIN=30
# Batas pesan per jam untuk user biasa (admin tidak dibatasi). 0 = tanpa batas
RATE_LIMIT_PER_HOUR=30
# Batas ukuran foto (MB)
MAX_IMAGE_MB=8
# Maksimal permintaan AI yang diproses bersamaan
MAX_CONCURRENT_AI=3
# Balas di grup? (true/false). Default hanya chat pribadi
ALLOW_GROUPS=false

# ====== SISTEM ======
# Folder sesi WA. Disamakan dengan bot lama supaya TIDAK perlu scan QR ulang
AUTH_DIR=sesi_wa_sayuretam
DATA_DIR=data
LOG_LEVEL=info
